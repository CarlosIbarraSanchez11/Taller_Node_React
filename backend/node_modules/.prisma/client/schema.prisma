generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Taller {
  id        Int        @id @default(autoincrement())
  nombre    String
  usuarios  Usuario[]
  productos Producto[]
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       String
  estado    String   @default("Activo")
  tallerId  Int?
  taller    Taller?  @relation(fields: [tallerId], references: [id])
  citas     Cita[]
  createdAt DateTime @default(now())

  @@index([tallerId])
}

model Producto {
  id          Int     @id @default(autoincrement())
  nombre      String
  codigo      String?
  marca       String?
  categoria   String
  stockActual Int     @default(0)
  stockMin    Int     @default(5)
  medida      String

  tallerId Int
  taller   Taller @relation(fields: [tallerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([nombre, marca, medida, tallerId])
}

model Vehiculo {
  placa      String @id
  marca      String
  modelo     String
  clienteNom String
  telefono   String
  citas      Cita[]
}

model Servicio {
  id       Int    @id @default(autoincrement())
  nombre   String
  precio   Float
  duracion String
  citas    Cita[]
}

model Cita {
  id                 String   @id @default(cuid())
  fecha              DateTime
  hora_inicio        String
  hora_fin           String
  estado             String   @default("PENDIENTE")
  token_confirmacion String   @unique @default(cuid())

  vehiculoPlaca String
  vehiculo      Vehiculo @relation(fields: [vehiculoPlaca], references: [placa])

  tecnicoId Int
  tecnico   Usuario @relation(fields: [tecnicoId], references: [id])

  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  createdAt DateTime @default(now())

  @@index([vehiculoPlaca])
  @@index([tecnicoId])
  @@index([servicioId])
}

model Proveedor {
  id          Int     @id @default(autoincrement())
  ruc         String  @unique // <--- Regla de oro: No se repite
  razonSocial String
  telefono    String?
  email       String?
  direccion   String?
  estado      String  @default("Activo") // Activo / Inactivo

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rentabilidad {
  id           Int      @id @default(1)
  alquiler     Float    @default(0)
  gestion      Float    @default(0)
  marketing    Float    @default(0)
  herramientas Float    @default(0)
  transporte   Float    @default(0)
  utilidad     Float    @default(0)
  updatedAt    DateTime @updatedAt
}
