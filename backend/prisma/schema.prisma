generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Taller {
  id        Int     @id @default(autoincrement())
  nombre    String
  direccion String?
  telefono  String?

  citas           Cita[]
  usuarios        Usuario[]
  productos       Producto[]
  ingresosDestino IngresoStock[] @relation("TallerDestino")

  ingresosOrigen   IngresoStock[] @relation("TallerOrigen")
  pedidosRecibidos Pedido[]       @relation("PedidosRecibidos")
  pedidosEnviados  Pedido[]       @relation("PedidosEnviados")
}

model Usuario {
  id       Int     @id @default(autoincrement())
  nombre   String
  email    String  @unique
  password String
  rol      String
  estado   String  @default("Activo")
  tallerId Int?
  taller   Taller? @relation(fields: [tallerId], references: [id])
  citas    Cita[]

  ordenesRecibidas OrdenTrabajo[]

  ingresos IngresoStock[]

  // 🚀 RELACIÓN PARA PEDIDOS (Agregado)
  pedidos Pedido[]

  createdAt DateTime @default(now())

  @@index([tallerId])
}

model Producto {
  id Int @id @default(autoincrement())

  costoMaestroId Int
  costoMaestro   CostoMaestro @relation(fields: [costoMaestroId], references: [id])

  tallerId Int
  taller   Taller @relation(fields: [tallerId], references: [id])

  stockActual Int @default(0)
  stockMin    Int @default(5)

  codigo String? @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([costoMaestroId, tallerId])
}

model CostoMaestro {
  id        Int    @id @default(autoincrement())
  categoria String
  nombre    String
  marca     String
  medida    String

  precioCompra Float @default(0)
  tiempoHH     Float @default(0)
  costoHH      Float @default(0)
  cantTecnicos Int   @default(1)
  precioVenta  Float @default(0)

  productos Producto[]
  ingresos  IngresoStock[]
  hallazgos Hallazgo[]
  pedidos Pedido[]

  @@unique([nombre, marca, medida])
}

model Cliente {
  id            Int     @id @default(autoincrement())
  tipoDocumento String
  numDocumento  String  @unique
  nombres       String
  apellidos     String
  telefono      String
  email         String?

  vehiculos Vehiculo[]
  createdAt DateTime   @default(now())
}

model Vehiculo {
  id          Int     @id @default(autoincrement())
  placa       String  @unique
  marca       String
  modelo      String
  anio        Int?
  combustible String
  tipo        String
  color       String?

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  citas     Cita[]
  createdAt DateTime @default(now())
}

enum TipoServicio {
  MANTENIMIENTO
  DIAGNOSTICO
}

model Servicio {
  id                Int          @id @default(autoincrement())
  tipo              TipoServicio
  especialidad      String
  nivel             String
  tecnologia        String
  categoriaVehiculo String
  duracion          String
  precioBase        Decimal      @db.Decimal(10, 2)
  kitProductos      String?      @db.Text

  kit KitInsumo[]

  // Relación con los pasos (la que ya teníamos)
  pasos PasoServicio[]

  // RELACIÓN FALTANTE: Esto es lo que pide el error
  citas Cita[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model KitInsumo {
  id         Int      @id @default(autoincrement())
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  descripcion String // Aquí irá: "BUJIAS", "FILTRO DE ACEITE", etc.
  cantidad    Float // Aquí irá: 4, 1, 5.5, etc.
}

model Sector {
  id     Int            @id @default(autoincrement())
  nombre String         @unique
  pasos  PasoServicio[]
}

model PasoServicio {
  id         Int      @id @default(autoincrement())
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id], onDelete: Cascade)

  sectorId Int?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  seccion     String? // Solo se usa si es MANTENIMIENTO
  descripcion String  @db.Text
  orden       Int     @default(0)
}

model Cita {
  id                 String   @id @default(cuid())
  fecha              DateTime
  hora_inicio        String
  hora_fin           String
  estado             String   @default("PENDIENTE")
  token_confirmacion String   @unique @default(cuid())

  // Relación directa con el Taller
  tallerId Int
  taller   Taller @relation(fields: [tallerId], references: [id])

  vehiculoPlaca String
  vehiculo      Vehiculo @relation(fields: [vehiculoPlaca], references: [placa])

  tecnicoId Int
  tecnico   Usuario @relation(fields: [tecnicoId], references: [id])

  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  ordenTrabajo OrdenTrabajo?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tallerId])
  @@index([vehiculoPlaca])
  @@index([tecnicoId])
  @@index([servicioId])
}

model OrdenTrabajo {
  id                String   @id @default(cuid())

  // 🔗 Relación 1:1 con Cita
  citaId            String   @unique
  cita              Cita     @relation(fields: [citaId], references: [id], onDelete: Cascade)

  // 👤 Mecánico que realizó la recepción/trabajo
  mecanicoId        Int
  mecanico          Usuario  @relation(fields: [mecanicoId], references: [id])

  // 📈 Gestión de Progreso (NUEVO)
  progreso          Int      @default(0) // 0 a 100%
  estado            String   @default("RECIBIDO") // RECIBIDO, INSPECCION, PRESUPUESTO, EJECUCION, FINALIZADO

  // 📝 Datos Técnicos de Ingreso
  kilometraje       Int
  nivelCombustible  String   
  gradoAceite       String?
  marcaAceiteSugerida String?
  inventario        Json    
  observaciones     String?  @db.Text
  fotos             Json?    

  inspeccionTecnica Json?

  // 🛠️ Relaciones de Operación (NUEVO)
  hallazgos         Hallazgo[]
  items             ItemOrden[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([citaId])
  @@index([mecanicoId])
}

model Hallazgo {
  id          String       @id @default(cuid())
  ordenId     String
  orden       OrdenTrabajo @relation(fields: [ordenId], references: [id])
  
  costoMaestroId Int?
  costoMaestro   CostoMaestro? @relation(fields: [costoMaestroId], references: [id])

  puntoFalla  String       // Eje: "Fuga en amortiguador" o el nombre del producto
  descripcion String?      @db.Text
  
  cantidad    Int          @default(1)
  precioVenta Float        @default(0) // Snapshot del precio en ese momento
  total       Float        @default(0) // $Total = Cantidad \times precioVenta$
  
  foto        String?
  estado      String       @default("POR ENVIAR") // POR ENVIAR, PENDIENTE, APROBADO, RECHAZADO
  
  createdAt   DateTime     @default(now())
}

model ItemOrden {
  id             String       @id @default(cuid())
  ordenId        String
  orden          OrdenTrabajo @relation(fields: [ordenId], references: [id])
  nombre         String
  cantidad       Int          @default(1)
  precioVenta    Decimal      @db.Decimal(10, 2)
  esAdicional    Boolean      @default(false) // true si viene de un hallazgo
  estado         String       @default("SOLICITADO") 
}

model Proveedor {
  id          Int            @id @default(autoincrement())
  ruc         String         @unique
  razonSocial String
  telefono    String?
  email       String?
  direccion   String?
  estado      String         @default("Activo")
  ingresos    IngresoStock[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Rentabilidad {
  id           Int      @id @default(1)
  alquiler     Float    @default(0)
  gestion      Float    @default(0)
  marketing    Float    @default(0)
  herramientas Float    @default(0)
  transporte   Float    @default(0)
  utilidad     Float    @default(0)
  updatedAt    DateTime @updatedAt
}

model IngresoStock {
  id       Int    @id @default(autoincrement())
  tipo     String // "CON_RUC", "SIN_RUC", "INTERNO"
  motivo   String // "CARGA_INICIAL", "AJUSTE", "TRANSFERENCIA"
  cantidad Int
  estado   String @default("PENDIENTE") // PENDIENTE, APROBADO, SOLICITADO

  // Apuntamos al Maestro para poder solicitar cosas que aún no tenemos en stock local
  costoMaestroId Int
  costoMaestro   CostoMaestro @relation(fields: [costoMaestroId], references: [id])

  tallerId Int // Sede que recibe
  taller   Taller @relation("TallerDestino", fields: [tallerId], references: [id])

  tallerOrigenId Int? // Sede que envía (para transferencias)
  tallerOrigen   Taller? @relation("TallerOrigen", fields: [tallerOrigenId], references: [id])

  proveedorId Int?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([costoMaestroId])
  @@index([tallerId])
}

enum PedidoEstado {
  PENDIENTE
  DESPACHADO
  RECHAZADO
  ENTREGADO
  CANCELADO
}

enum PedidoTipo {
  TRANSFERENCIA
  CLIENTE
  SERVICIO
}

// --- MODELO DE PEDIDOS ---
model Pedido {
  id            Int          @id @default(autoincrement())
  codigo        String       @unique
  tipo          PedidoTipo   @default(TRANSFERENCIA)
  estado        PedidoEstado @default(PENDIENTE)
  cantidad      Int
  placa         String?
  solicitante   String?
  observaciones String?

  costoMaestroId Int
  costoMaestro   CostoMaestro @relation(fields: [costoMaestroId], references: [id])

  tallerId Int
  taller   Taller @relation("PedidosRecibidos", fields: [tallerId], references: [id])

  tallerOrigenId Int?
  tallerOrigen   Taller? @relation("PedidosEnviados", fields: [tallerOrigenId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
