generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Taller {
  id               Int            @id @default(autoincrement())
  nombre           String
  usuarios         Usuario[]
  productos        Producto[]
  ingresosDestino  IngresoStock[] @relation("TallerDestino")
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nombre    String
  email     String   @unique
  password  String
  rol       String
  estado    String   @default("Activo")
  tallerId  Int?
  taller    Taller?  @relation(fields: [tallerId], references: [id])
  citas     Cita[]
  // Relación con ingresos registrados por este usuario
  ingresos  IngresoStock[]
  createdAt DateTime @default(now())

  @@index([tallerId])
}

